{
  "name": "@mosaicstack/mcp-orchestrator",
  "version": "1.0.0",
  "description": "MosAIc Stack MCP orchestrator for OpenCode integration",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "mosaic-mcp": "./bin/mosaic-mcp"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "dev": "tsx src/main.ts",
    "start": "node dist/main.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --coverage --passWithNoTests",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "lint:ci": "eslint src/**/*.ts --format=json --output-file=lint-results.json",
    "format": "prettier --write src/**/*.ts",
    "format:check": "prettier --check src/**/*.ts",
    "type-check": "tsc --noEmit",
    "clean": "rimraf dist coverage lint-results.json",
    "validate": "npm run type-check && npm run lint && npm run test:ci",
    "validate:ci": "scripts/validate-ci.sh",
    "prepublishOnly": "npm run clean && npm run build",
    "prepack": "npm run build",
    "serve": "node dist/main.js serve",
    "health-check": "node dist/main.js health",
    "tools": "node dist/main.js tools"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "opencode",
    "mosaic",
    "ai",
    "orchestration",
    "task-management",
    "agent-coordination"
  ],
  "author": "MosAIc Stack Team",
  "license": "MIT",
  "homepage": "https://github.com/jetrich/mosaic-sdk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jetrich/mosaic-sdk.git",
    "directory": "packages/mcp-orchestrator"
  },
  "bugs": {
    "url": "https://github.com/jetrich/mosaic-sdk/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^0.4.0",
    "commander": "^11.1.0",
    "cors": "2.8.5",
    "dotenv": "^16.3.1",
    "express": "4.21.2",
    "js-yaml": "^4.1.0",
    "sqlite3": "^5.1.6",
    "uuid": "^9.0.1",
    "winston": "^3.11.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "4.17.23",
    "@types/jest": "^29.5.8",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.0.0",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^6.12.0",
    "@typescript-eslint/parser": "^6.12.0",
    "eslint": "^8.54.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.1",
    "jest": "^29.7.0",
    "prettier": "^3.1.0",
    "rimraf": "^5.0.5",
    "ts-jest": "^29.1.1",
    "tsx": "^4.6.0",
    "typescript": "^5.3.2"
  },
  "files": [
    "dist/",
    "bin/",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  }
}
