{
  "name": "@mosaic/planning-plugin",
  "version": "0.1.0",
  "description": "Business-to-technical planning plugin for MosAIc SDK with command-driven decomposition and dependency management",
  "keywords": [
    "mosaic",
    "planning",
    "business-strategy",
    "task-decomposition",
    "semver",
    "release-planning",
    "scope-control"
  ],
  "author": "MosAIc Development Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/mosaic-sdk",
    "directory": "packages/planning-plugin"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "docs",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.{js,ts}",
    "format": "prettier --write src/**/*.{js,ts}",
    "docs": "typedoc src --out docs/api",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@mosaicstack/config": "workspace:*",
    "@mosaicstack/mcp-common": "workspace:*",
    "zod": "^3.22.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/uuid": "^9.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.45.0",
    "jest": "^29.6.0",
    "@types/jest": "^29.5.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.1.0",
    "prettier": "^3.0.0",
    "typedoc": "^0.24.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}