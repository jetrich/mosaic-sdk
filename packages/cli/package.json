{
  "name": "@mosaicstack/cli",
  "version": "0.1.0",
  "description": "Command-line interface for MosAIc Stack multi-mode architecture",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "mosaic": "dist/bin/mosaic.js"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "clean": "rm -rf dist/",
    "lint": "eslint src/ --ext .ts",
    "lint:fix": "eslint src/ --ext .ts --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "dev": "npm run build && node dist/bin/mosaic.js"
  },
  "keywords": [
    "mosaic",
    "cli",
    "multi-mode",
    "ai",
    "development",
    "platform"
  ],
  "author": "MosAIc Stack",
  "license": "MIT",
  "dependencies": {
    "@mosaicstack/config": "^0.1.0",
    "@mosaicstack/providers": "^0.1.0",
    "commander": "^11.1.0",
    "inquirer": "^9.2.0",
    "chalk": "^5.3.0",
    "ora": "^7.0.0",
    "boxen": "^7.1.0",
    "figlet": "^1.7.0",
    "update-notifier": "^7.0.0",
    "node-fetch": "^3.3.0"
  },
  "devDependencies": {
    "@types/figlet": "^1.5.0",
    "@types/inquirer": "^9.0.0",
    "@types/node": "^18.0.0",
    "@types/update-notifier": "^6.0.0",
    "@types/node-fetch": "^2.6.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "jest": "^29.0.0",
    "typescript": "^5.0.0"
  },
  "files": [
    "dist/**/*"
  ],
  "engines": {
    "node": ">=18.0.0"
  }
}