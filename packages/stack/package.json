  "repository": {
    "type": "git",
    "url": "https://github.com/jetrich/mosaic-sdk.git",
    "directory": "packages/stack"
  },
  "bugs": {
    "url": "https://github.com/jetrich/mosaic-sdk/issues"
  },
  "homepage": "https://mosaicstack.dev"
