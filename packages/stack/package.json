{
  "name": "@mosaicstack/stack",
  "version": "0.1.0",
  "description": "MosAIc Stack meta-package - Complete enterprise AI development platform orchestrator",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
