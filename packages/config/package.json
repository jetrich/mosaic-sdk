{
  "name": "@mosaicstack/config",
  "version": "0.1.0",
  "description": "Configuration management for MosAIc Stack multi-mode architecture",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "clean": "rm -rf dist/",
    "lint": "eslint src/ --ext .ts",
